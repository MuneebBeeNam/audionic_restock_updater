# ==============================================================
# AUDIONIC RESTOCK NOTIFIER CONFIGURATION
# ==============================================================

# Product URL to monitor
PRODUCT_URL=https://audionic.co/products/trance-infinity

# --------------------------------------------------------------
# OPTION 1: ntfy.sh (RECOMMENDED - EASIEST & 100% FREE)
# --------------------------------------------------------------
# 1. Install 'ntfy' app on your phone (iOS App Store or Android Google Play).
# 2. Open the app, tap '+', and subscribe to a unique topic name below.
# 3. Put that same unique topic name here:
NTFY_TOPIC=audionic_trance_infinity_restock_yourkey123

# --------------------------------------------------------------
# OPTION 2: TELEGRAM BOT (OPTIONAL)
# --------------------------------------------------------------
# 1. Message @BotFather on Telegram, type /newbot, get your BOT_TOKEN.
# 2. Message @userinfobot to get your numeric CHAT_ID.
# 3. Start a chat with your new bot and fill in the values below:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --------------------------------------------------------------
# OPTION 3: DISCORD WEBHOOK (OPTIONAL)
# --------------------------------------------------------------
# In Discord: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# --------------------------------------------------------------
# LOOP SETTINGS (For local continuous running)
# --------------------------------------------------------------
# Check interval in seconds (e.g. 120 = every 2 minutes)
CHECK_INTERVAL_SECONDS=120
